{
  "name": "dsh-phoneharness",
  "version": "0.5.19",
  "private": false,
  "type": "module",
  "description": "用手机 APK 远程控制本机 DeepSeek Harness：自建对外 HTTP/SSE 端口 + 一次性配对码，手机上发指令、看时间线、答审批。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "android",
    "sse"
  ],
  "license": "MIT",
  "author": "dsh-phoneharness contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DongLiKVK/dsh-phoneharness.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/DongLiKVK/dsh-phoneharness#readme",
  "bugs": {
    "url": "https://github.com/DongLiKVK/dsh-phoneharness/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "assets/",
    "docs/",
    "scripts/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "pack": "npm pack --silent"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
